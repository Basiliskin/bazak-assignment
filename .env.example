# ── LLM provider ──────────────────────────────────────────────────────────────
# openai (default) = gpt-6-luna, the only model the assignment allows.
# anthropic = Claude, for local development only.
# LLM_PROVIDER=openai

# ── OpenAI (LLM_PROVIDER=openai) ──────────────────────────────────────────────
OPENAI_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional: a proxy or gateway. Include /v1. Unset = https://api.openai.com/v1
# OPENAI_BASE_URL=

# ── Anthropic (LLM_PROVIDER=anthropic) ────────────────────────────────────────
# Key from platform.claude.com/settings/keys, billed per token (a claude.ai subscription is not API access).
# If unset, the SDK uses ANTHROPIC_AUTH_TOKEN or your `ant auth login` profile.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional: a proxy or gateway. Without /v1. Unset = https://api.anthropic.com
# ANTHROPIC_BASE_URL=

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
# Where searches look (ADR 0005): memory = download the whole Catalog (default); api = DummyJSON per search
# CATALOG_MODE=memory
